{
  "compilerOptions": {
    "target": "es2017",
    "lib": [
      "esnext"
    ],
    "jsx": "react-native",
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": false,
    "baseUrl": ".",
    "paths": {
      "@components/*": [
        "src/components/*"
      ],
      "@screens/*": [
        "src/screens/*"
      ],
      "@lib/*": [
        "src/lib/*"
      ],
      "@state/*": [
        "src/state/*"
      ],
      "@types/*": [
        "src/types/*"
      ]
    }
  },
  "extends": "expo/tsconfig.base"
}
